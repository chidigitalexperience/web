---
interface Props {
  variant?: 'home' | 'compact';
}

const { variant = 'compact' } = Astro.props;

const nav = [
  { href: '/', label: 'Digital Experience Competition' },
  { href: '/programme-data/', label: 'Programme Data' },
  { href: '/judging/', label: 'Judging' },
  { href: '/accepted-teams/', label: 'Accepted Teams' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/#contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header">
  <nav aria-label="Primary" id="main-nav" class:list={['main-nav', variant === 'home' && 'main-nav-home']}>
    <div class="container nav-inner">
      <button
        type="button"
        class="nav-toggle"
        aria-expanded="false"
        aria-controls="primary-nav"
      >
        <span class="visually-hidden">Menu</span>
        <span class="nav-toggle-icon" aria-hidden="true"></span>
      </button>

      <ul id="primary-nav" class="primary-nav">
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
        <li><a class="btn btn-primary enter-cta" href="/enter/">Enter</a></li>
      </ul>
    </div>
  </nav>

  {variant === 'home' ? (
    <div id="header" class="banner banner-home">
      <img class="banner-img banner-img-home-cityscape" src="/brand/chi2027-cityscape.svg" alt="" aria-hidden="true" />
    </div>
  ) : (
    <div id="header" class="banner banner-compact">
      <img class="banner-img" src="/brand/chi2027-compact-banner.svg" alt="" aria-hidden="true" />
      <p class="banner-title">Digital Experience Competition</p>
    </div>
  )}
</header>

<style>
  .site-header {
    position: relative;
  }

  .main-nav {
    background-color: var(--color-navy);
    width: 100%;
  }

  .main-nav-home {
    background-color: #fff;
  }

  .main-nav-home .primary-nav a:not(.btn) {
    color: var(--color-navy);
  }

  .main-nav-home .primary-nav a[aria-current='page'] {
    color: var(--color-blue-2);
  }

  .main-nav-home .nav-toggle {
    border-color: var(--color-border);
  }

  .main-nav-home .nav-toggle-icon,
  .main-nav-home .nav-toggle-icon::before,
  .main-nav-home .nav-toggle-icon::after {
    background: var(--color-navy);
  }

  .nav-inner {
    display: flex;
    align-items: center;
    padding: 0.85rem 1.25rem;
  }

  .primary-nav {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px;
    margin: 0;
    padding: 0;
  }

  .primary-nav a:not(.btn) {
    color: #fff;
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
    line-height: 1.2;
    white-space: nowrap;
    padding: 6px 0;
    display: inline-block;
  }

  .primary-nav a:not(.btn):hover {
    opacity: 0.85;
  }

  .primary-nav a[aria-current='page'] {
    text-decoration: underline;
    text-underline-offset: 4px;
  }

  .enter-cta {
    white-space: nowrap;
  }

  .banner {
    position: relative;
    width: 100%;
    overflow: hidden;
    line-height: 0;
  }

  .banner-img {
    display: block;
    width: 100%;
    height: auto;
    margin: 0 auto;
  }

  .banner-img-home-logo {
    width: min(680px, 100vw);
    padding: 10px 10px 0 10px;
    margin: 0 auto;
  }

  .banner-img-home-cityscape {
    height: 46vh;
    object-fit: cover;
    object-position: top center;
  }

  .banner-compact {
    background: var(--color-navy);
  }

  .banner-title {
    position: absolute;
    left: -9999px;
  }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 2.5rem;
    height: 2.5rem;
    padding: 0;
    background: transparent;
    border: 1.5px solid rgba(255, 255, 255, 0.4);
    border-radius: var(--radius);
    cursor: pointer;
    margin-right: 0.75rem;
  }

  .nav-toggle-icon,
  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    display: block;
    width: 1.25rem;
    height: 2px;
    background: #fff;
    border-radius: 1px;
    position: relative;
    transition: transform 0.15s ease, opacity 0.15s ease;
  }

  .nav-toggle-icon::before,
  .nav-toggle-icon::after {
    content: '';
    position: absolute;
    left: 0;
  }

  .nav-toggle-icon::before {
    top: -6px;
  }

  .nav-toggle-icon::after {
    top: 6px;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-icon {
    background: transparent;
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-icon::before {
    top: 0;
    transform: rotate(45deg);
  }

  .nav-toggle[aria-expanded='true'] .nav-toggle-icon::after {
    top: 0;
    transform: rotate(-45deg);
  }

  @media (max-width: 780px) {
    .nav-toggle {
      display: flex;
    }

    .primary-nav {
      display: none;
      flex-direction: column;
      align-items: stretch;
      width: 100%;
      padding: 0.5rem 0 1rem;
      gap: 0.75rem;
    }

    .primary-nav.is-open {
      display: flex;
    }

    .primary-nav a:not(.btn) {
      width: 100%;
    }

    .enter-cta {
      text-align: center;
      display: block;
    }
  }
</style>

<script>
  const toggle = document.querySelector<HTMLButtonElement>('.nav-toggle');
  const nav = document.getElementById('primary-nav');

  if (toggle && nav) {
    toggle.addEventListener('click', () => {
      const isOpen = nav.classList.toggle('is-open');
      toggle.setAttribute('aria-expanded', String(isOpen));
    });

    nav.addEventListener('click', (event) => {
      if ((event.target as HTMLElement).tagName === 'A' && window.matchMedia('(max-width: 780px)').matches) {
        nav.classList.remove('is-open');
        toggle.setAttribute('aria-expanded', 'false');
      }
    });
  }
</script>
