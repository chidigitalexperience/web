---
const nav = [
  { href: '/', label: 'Overview' },
  { href: '/programme-data/', label: 'Programme Data' },
  { href: '/judging/', label: 'Judging' },
  { href: '/accepted-teams/', label: 'Accepted Teams' },
  { href: '/faq/', label: 'FAQ' },
  { href: '/#contact', label: 'Contact' },
];

const currentPath = Astro.url.pathname;
---

<a class="skip-link" href="#main">Skip to main content</a>
<header class="site-header">
  <div class="container header-inner">
    <a class="brand" href="/">
      <span class="brand-title">CHI Digital Experience Competition</span>
    </a>
    <nav aria-label="Primary">
      <ul>
        {nav.map((item) => (
          <li>
            <a href={item.href} aria-current={currentPath === item.href ? 'page' : undefined}>
              {item.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="btn btn-primary enter-cta" href="/enter/">Enter</a>
  </div>
</header>

<style>
  .site-header {
    background: transparent;
    color: var(--color-text);
  }

  .header-inner {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem;
    padding: 1rem 1.25rem;
  }

  .brand {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: var(--color-navy);
    margin-right: auto;
  }

  .brand-title {
    font-weight: 700;
    font-size: 1.05rem;
  }

  nav ul {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1rem;
    margin: 0;
    padding: 0;
  }

  nav a {
    color: var(--color-text);
    text-decoration: none;
    font-size: 0.9rem;
    font-weight: 600;
    padding: 0.45rem 0.9rem;
    border-radius: 999px;
    border: 1.5px solid transparent;
    display: inline-block;
  }

  nav a:hover {
    border-color: var(--color-border);
  }

  nav a[aria-current='page'] {
    background: var(--color-bg-alt);
    border-color: var(--color-yellow-dark);
    color: var(--color-navy);
  }

  .enter-cta {
    padding: 0.55rem 1.3rem;
    border-radius: 999px;
  }

  @media (max-width: 640px) {
    .header-inner {
      flex-direction: column;
      align-items: flex-start;
    }

    .enter-cta {
      order: -1;
    }
  }
</style>
