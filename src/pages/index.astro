---
import BaseLayout from '../layouts/BaseLayout.astro';

const keyDates = [
  {
    group: 'Prototype',
    items: [
      { label: 'Submissions open', date: 'Sept. 11, 2026' },
      { label: 'Submission due', date: 'Dec. 4, 2026' },
      { label: 'Notification', date: 'End of Jan. 2027' },
    ],
  },
  {
    group: 'Accepted stage',
    items: [
      { label: 'Submission due', date: 'Mar. 26, 2027' },
      { label: 'Programme feed live', date: 'April 2027' },
    ],
  },
  {
    group: 'Showcase',
    items: [{ label: 'ACM CHI 2027, Pittsburgh', date: 'May 10–14, 2027' }],
  },
];
---

<BaseLayout title="Overview" fullBleed headerVariant="home">
  <section class="hero">
    <div class="container hero-inner">
      <h1>Reimagine the attendee experience.</h1>
      <p class="lede">
        Developers, designers, and researchers are invited to build apps and
        tools that innovate the <strong>attendee experience</strong> of
        ACM&nbsp;CHI&nbsp;2027 — going beyond the official programme app.
      </p>
      <div class="hero-actions">
        <a class="btn btn-primary" href="/enter/">Submit your prototype</a>
        <a class="btn btn-outline" href="https://chi2027.acm.org/digital-experience-competition/" target="_blank" rel="noopener">
          CHI 2027 site <span aria-hidden="true">&#8599;</span>
        </a>
      </div>
    </div>
  </section>

  <div class="container page-body">
    <div class="body-grid">
      <div class="main-col">
        <section>
          <h2>What this is</h2>
          <p class="section-lede">
            This site is the operational home of the competition: full details,
            the programme data and API we provide, the judging process, and the
            submission forms. Promotional material and the headline
            call-to-action live on the <a href="https://chi2027.acm.org/digital-experience-competition/">main CHI 2027 site</a>, which
            links here.
          </p>
        </section>

        <section>
          <h2>What we provide</h2>
          <div class="provide-grid">
            <div class="provide-card">
              <strong>A live-updating programme feed</strong>
              <p>
                One URL, no API key, no sign-up. Historical CHI programme data
                (CHI 2023–2026) is available today, plus a synthetic
                sandbox feed at CHI 2027 scale for testing.
              </p>
              <a href="/programme-data/">Read the full documentation &rarr;</a>
            </div>
            <div class="provide-card">
              <strong>Possible Compute / LLM API credits</strong>
              <p>Pending sponsorship. Watch this space.</p>
            </div>
          </div>
        </section>

        <section class="cta-block-inline">
          <h2>Ready to enter?</h2>
          <p>
            The initial submission is a prototype / proof of concept. See
            the <a href="/judging/">judging criteria</a> and then head to
            the <a href="/enter/">Enter</a> page.
          </p>
          <a class="btn btn-outline" href="/enter/">Submit your prototype</a>
        </section>

        <section id="contact">
          <h2>Contact</h2>
          <p>
            For competition queries, judging enquiries, or anything about the
            programme data: <a href="mailto:app@chi2027.acm.org">app@chi2027.acm.org</a>.
          </p>
          <p>
            For general CHI 2027 conference enquiries unrelated to this
            competition, see the <a href="https://chi2027.acm.org/digital-experience-competition/">main CHI 2027 site</a>.
          </p>
        </section>
      </div>

      <aside class="dates-col" aria-label="Key dates">
        <h3><strong>Key Dates</strong></h3>
        <table class="dates-table">
          <tbody>
            {keyDates.map((group) => (
              <>
                <tr class="dates-group-row">
                  <td><strong>{group.group}</strong></td>
                </tr>
                <tr>
                  <td>
                    {group.items.map((item, i) => (
                      <>
                        {i > 0 && <br />}
                        <strong>{item.date}</strong> {item.label}
                      </>
                    ))}
                  </td>
                </tr>
              </>
            ))}
          </tbody>
        </table>
      </aside>
    </div>
  </div>
</BaseLayout>

<style>
  .hero {
    background: var(--color-bg);
  }

  .hero-inner {
    padding: 2.5rem 1.25rem 3rem;
    text-align: center;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 1.25rem;
    margin-top: 1.5rem;
  }

  .hero-inner h1 {
    max-width: 20ch;
    margin: 0 auto 1rem;
  }

  .lede {
    font-size: 1.2rem;
    color: var(--color-text-muted);
    max-width: 56ch;
    margin: 0 auto;
  }

  .page-body {
    padding: 2.5rem 1.25rem 3rem;
  }

  .body-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 300px;
    gap: 2.5rem;
    align-items: start;
  }

  .main-col section {
    margin-bottom: 2.5rem;
  }

  .main-col h2 {
    color: var(--color-navy);
  }

  .section-lede {
    max-width: 65ch;
    color: var(--color-text-muted);
    font-size: 1.05rem;
  }

  .provide-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1.5rem;
    margin-top: 1.5rem;
  }

  .provide-card {
    background: var(--color-bg-alt);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    padding: 1.5rem;
  }

  .provide-card strong {
    display: block;
    font-size: 1.1rem;
    color: var(--color-navy);
    margin-bottom: 0.5rem;
  }

  .cta-block-inline {
    background: var(--color-bg-alt);
    border-left: 4px solid var(--color-coral);
    border-radius: var(--radius);
    padding: 1.5rem 1.75rem;
  }

  .cta-block-inline .btn {
    margin-top: 0.75rem;
  }

  .dates-col {
    max-width: 250px;
    position: sticky;
    top: 1.5rem;
  }

  .dates-col h3 {
    margin: 0 0 0;
    color: var(--color-navy);
    font-size: 22px;
    font-weight: 600;
  }

  .dates-table {
    width: 100%;
    max-width: 250px;
    font-size: 14px;
    line-height: 1.6;
    border-collapse: collapse;
    margin: 1rem 0 0;
  }

  .dates-table td {
    border: none;
    padding: 7px;
    color: var(--color-navy);
    vertical-align: top;
  }

  .dates-group-row td {
    background: #f0f0f0;
  }

  @media (max-width: 860px) {
    .body-grid {
      grid-template-columns: 1fr;
    }

    .dates-col {
      position: static;
      max-width: none;
    }

    .dates-table {
      max-width: none;
    }
  }

  @media (max-width: 640px) {
    .hero-inner {
      padding: 2.5rem 1.25rem 2rem;
    }
  }
</style>
